# Copy to .env for local development and replace the placeholder values.
# Never commit .env or reuse these placeholders in a deployed environment.
PROJECT_NAME=FastAPI
SECRET_KEY=replace_with_a_generated_secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace_with_a_unique_local_password
POSTGRES_PASSWORD=replace_with_a_unique_local_password
DATABASE_URL=postgresql+psycopg://postgres:replace_with_a_unique_local_password@localhost:5432/app
DOMAIN=localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=false
SMTP_SSL=false
EMAILS_FROM_EMAIL=
SENTRY_DSN=
